{
    "version": "1.0.0",
    "description": "CreateYourNotes - a local-first notes app for Windows 10 and later. Your notes stay on your PC: no account, no sync, no tracking.",
    "homepage": "https://github.com/Vishalkirthik-TV/createyournotes",
    "license": "MIT",
    "notes": [
        "Notes and settings are stored in scoop\\persist\\createyournotes\\holdmynotes.db and are preserved across updates and uninstalls.",
        "Launch from the Start menu as 'CreateYourNotes', or from a terminal with 'holdmynotes'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Vishalkirthik-TV/createyournotes/releases/download/v1.0.0/CreateYourNotes-1.0.0-win-x64.zip",
            "hash": "0c7699ff16b1ee44267af3a12b668efa434da14e437bb40b7b17cf3e4961311c"
        }
    },
    "bin": "HoldMyNotes.exe",
    "shortcuts": [
        [
            "HoldMyNotes.exe",
            "CreateYourNotes"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path (Join-Path $dir 'holdmynotes.db'))) { New-Item -ItemType File -Path (Join-Path $dir 'holdmynotes.db') | Out-Null }"
    ],
    "persist": "holdmynotes.db",
    "checkver": {
        "url": "https://github.com/Vishalkirthik-TV/createyournotes/releases.atom",
        "regex": "releases/tag/v(?<version>[^\"]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Vishalkirthik-TV/createyournotes/releases/download/v$version/CreateYourNotes-$version-win-x64.zip"
            }
        }
    }
}
